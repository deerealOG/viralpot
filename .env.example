# ViralPot Environment Variables
# Copy this file to .env.local and fill in your values

# Groq API (for AI content generation)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Paystack Configuration (for subscriptions)
# Get these from Paystack Dashboard > Settings > API Keys & Webhooks
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Paystack Plan Codes (create subscription plans in Paystack Dashboard)
VITE_PAYSTACK_PRO_PLAN=PLN_your_pro_plan_code
VITE_PAYSTACK_BUSINESS_PLAN=PLN_your_business_plan_code
